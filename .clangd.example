# ============================================================================
#  .clangd 템플릿 — 이 파일을 `.clangd` 로 복사한 뒤 절대 경로를 본인 환경에 맞게 수정하십시오.
# ============================================================================
#  [왜 .example 인가]
#    실제 `.clangd` 는 로컬 절대 경로(D:/Mydev/... 등)를 담기 때문에
#    커밋 7c004e5 에서 `.gitignore` 에 추가되었습니다(로컬 절대경로 노출 방지).
#    그런데 이 파일에는 **잘못 건드리면 파일마다 22개 가짜 오류가 나는 설정**이 들어 있어,
#    지침이 저장소에 남지 않으면 새 환경에서 같은 함정을 반복하게 됩니다.
#    그래서 경로만 자리표시자로 바꾼 템플릿을 추적 대상으로 둡니다.
#    (프로젝트가 이미 쓰는 방식 — appsettings.Production.json → .example 과 동일한 패턴)
#
#  [사용법]
#    1) 이 파일을 저장소 루트에 `.clangd` 로 복사
#    2) 아래 <REPO_ROOT> 를 실제 절대 경로로 모두 치환 (예: D:/Mydev/AI_MMORPG_Project)
#    3) compile_commands.json 생성 (§ 하단 절차)
#    4) clangd 22 이상 필요 — winget install LLVM.LLVM 후
#       C:\Program Files\LLVM\bin 을 PATH 에 추가하고 **터미널을 완전히 새로 열 것**
#       (실행 중인 콘솔은 PATH 변경을 다시 읽지 않습니다)
# ============================================================================

CompileFlags:
  # [2026-09-09] Ninja 구성으로 생성한 compile_commands.json 을 1순위로 사용합니다.
  #   재생성 절차 (PowerShell):
  #     $vc = "C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Auxiliary\Build\vcvars64.bat"
  #     cmd /c "`"$vc`" && cmake -S Server -B Server\build_ninja -G Ninja -DCMAKE_BUILD_TYPE=Debug ^
  #             -DCMAKE_TOOLCHAIN_FILE=<REPO_ROOT>/vcpkg/scripts/buildsystems/vcpkg.cmake ^
  #             -DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
  #
  #   ⚠️ PATH 를 직접 조작하지 마십시오. `vcvars64.bat && set "PATH=...;%PATH%" && cmake` 처럼
  #      한 줄로 이으면 %PATH% 가 vcvars 실행 **전에** 치환되어 컴파일러 경로가 사라집니다
  #      ("No CMAKE_CXX_COMPILER could be found"). vcvars 가 ninja 경로까지 넣어 주므로 불필요합니다.
  #
  #   ⚠️ Visual Studio 생성기는 CMAKE_EXPORT_COMPILE_COMMANDS 를 **무시**합니다.
  #      반드시 Ninja 생성기를 쓰고, 기존 Server/build/(VS 생성기)는 그대로 두십시오.
  #
  #   아래 Add: 항목들은 DB에 없는 파일(신규 파일 등)을 위한 폴백이므로 지우지 마십시오.
  CompilationDatabase: Server/build_ninja

  # [2026-09-09] compile_commands.json 에서 clangd 가 처리할 수 없는 MSVC 전용 플래그를 제거합니다.
  #   /Yu, /Fp : MSVC 가 생성한 이진 PCH(.pch)를 쓰라는 지시. clang 은 MSVC 이진 PCH 를 읽지 못합니다.
  #              제거해도 /FI cmake_pch.hxx 가 남아 clangd 가 헤더를 텍스트로 직접 파싱하므로 결과는 동일합니다.
  #   /Fo      : 오브젝트 출력 경로. 역슬래시 때문에 clangd 드라이버가
  #              "cannot specify '/Fo...' when compiling multiple source files" 로 오진합니다.
  #   ⚠️ 이 Remove 목록을 지우면 C++ 파일마다 20개 이상의 가짜 오류가 다시 나타납니다.
  Remove:
    - "/Yu*"
    - "/Fp*"
    - "/Fo*"
    - "-Yu*"
    - "-Fp*"
    - "-Fo*"

  Add:
    - "-xc++"
    - "-std=c++20"
    - "--target=x86_64-pc-windows-msvc"
    # 절대 경로를 명시하여 clangd가 어느 파일을 열든 정확한 위치를 참조하도록 강제합니다.
    - "-I"
    - "<REPO_ROOT>/Server/ServerCore"
    - "-I"
    - "<REPO_ROOT>/Server/GameServer/Packet"
    - "-I"
    - "<REPO_ROOT>/Server/DummyClient/Packet"
    - "-I"
    - "<REPO_ROOT>/vcpkg/installed/x64-windows/include"
    # CorePch.h 역시 절대 경로로 강제 주입
    #
    # 🚨🚨 여기가 가장 중요한 지점입니다 — 표기를 바꾸지 마십시오. 🚨🚨
    #
    #   반드시 MSVC 스타일 `/FI<path>` 여야 합니다. gcc 스타일 `-include <path>` 를 쓰면
    #   **파일마다 22개의 가짜 오류가 발생합니다.**
    #
    #   [이유]
    #   위 CompilationDatabase 때문에 clangd 가 쓰는 드라이버가 DB 커맨드(cl.exe)를 상속해
    #   MSVC 스타일이 됩니다. cl 드라이버는 `-include` 를 강제 include 로 해석하지 않고
    #   뒤따르는 경로를 **두 번째 입력 파일**로 취급합니다. clang-cl -### 실측 결과:
    #       job1: -emit-obj  -main-file-name "JobQueue.cpp"
    #       job2: -emit-pch  -main-file-name "CorePch.h"  -x c-header   ← 이것이 문제
    #   그 결과 프리앰블 구성이 실패하고 CorePch.h 의 모든 타입(uint64, int32, JobRef, std ...)이
    #   미정의로 쏟아집니다.
    #       - "cannot specify '/Fo...' when compiling multiple source files"
    #       - "main file cannot be included recursively when building a preamble"
    #   compile_commands.json 자체도 cmake_pch.hxx 를 `/FI` 로 주입하고 있습니다.
    #
    #   [CompilationDatabase 를 제거할 경우]
    #   드라이버가 다시 gcc 스타일이 되므로 이 항목을 아래 2줄로 **함께** 원복해야 합니다.
    #       - "-include"
    #       - "<REPO_ROOT>/Server/ServerCore/CorePch.h"
    #   즉 CompilationDatabase 와 /FI 는 한 묶음입니다. 한쪽만 바꾸면 오류가 재발합니다.
    - "/FI<REPO_ROOT>/Server/ServerCore/CorePch.h"

Diagnostics:
  # 미리 컴파일된 헤더(CorePch) 사용 시 발생하는 "Included header is not used directly" 경고를 무시합니다.
  UnusedIncludes: None

---
If:
  # 파이썬 Jinja 템플릿 폴더 내의 파일들에 대해서는 모든 에러 표시를 끕니다.
  PathMatch: "Shared/Scripts/Templates/.*"
Diagnostics:
  Suppress: "*"
