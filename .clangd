CompileFlags:
  Add:
    - "-xc++"
    - "-std=c++20"
    - "--target=x86_64-pc-windows-msvc"
    # 절대 경로를 명시하여 clangd가 어느 파일을 열든 정확한 위치를 참조하도록 강제합니다.
    - "-I"
    - "D:/Mydev/AI_MMORPG_Project/Server/ServerCore"
    - "-I"
    - "D:/Mydev/AI_MMORPG_Project/Server/GameServer/Packet"
    - "-I"
    - "D:/Mydev/AI_MMORPG_Project/Server/DummyClient/Packet"
    - "-I"
    - "D:/Mydev/AI_MMORPG_Project/vcpkg/installed/x64-windows/include"
    # CorePch.h 역시 절대 경로로 강제 주입
    - "-include"
    - "D:/Mydev/AI_MMORPG_Project/Server/ServerCore/CorePch.h"

Diagnostics:
  # 미리 컴파일된 헤더(CorePch) 사용 시 발생하는 "Included header is not used directly" 경고를 무시합니다.
  UnusedIncludes: None

---
If:
  # 파이썬 Jinja 템플릿 폴더 내의 파일들에 대해서는 모든 에러 표시를 끕니다.
  PathMatch: "Shared/Scripts/Templates/.*"
Diagnostics:
  Suppress: "*"
